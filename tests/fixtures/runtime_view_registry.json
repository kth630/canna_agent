{
  "registry_id": "runtime_view_synthetic_v1",
  "authority": "non_authoritative_synthetic",
  "purpose": "stage 1-A only: the single source of truth for candidate semantics used by the Runtime View retrieval experiment",
  "notes": [
    "Every label, meaning, surface form, entity, universe count and as-of date below is synthetic. None of it describes official Canna data.",
    "semantic_id is a stable server-side identifier. It is never sent to the model; the model only ever sees a per-request opaque ref.",
    "Retrieval code must not contain any alias, field name, predicate name or dataset binding. All of them live in this file.",
    "capability_coverage partitions every declared capability into supported or unsupported for each product family, so an unsupported capability is explicit rather than a silently missing candidate.",
    "neighbor_group, label homonymy, predicate_group and dataset ownership are the only structural links retrieval is allowed to follow."
  ],
  "retrieval_policy": {
    "candidate_budget": 24,
    "normalization": {
      "casefold": true,
      "strip_characters": " \t\n·,.()[]/-"
    },
    "neighbor_rules": [
      "same_neighbor_group",
      "cross_family_homonym",
      "predicate_sibling"
    ]
  },

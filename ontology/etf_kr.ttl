    cnn:meaningStatus "code_meaning_unverified" ; cnn:alignmentDecision "수정" .

##  3. 기간 수익률 - 기간마다 별도 의미이며 같은 모집단이 아니다

etkr:Return1D a cnn:MetricType ;
    rdfs:label "1일 수익률"@ko ; cnn:approvedAlias "일간 수익률"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:PercentObserved ; cnn:observationPeriod cnn:Period1D ;
    cnn:comparisonGroup "domestic_etp:return" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ,
        cnn:CompareOperation , cnn:CountOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresValueStatus ,
        cnn:RequiresCoverageUniverse ;
    cnn:meaningStatus "unit_observed_only" ; cnn:alignmentDecision "유지" .

etkr:Return1M a cnn:MetricType ;
    rdfs:label "1개월 수익률"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:PercentObserved ; cnn:observationPeriod cnn:Period1M ;
    cnn:comparisonGroup "domestic_etp:return" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ,
        cnn:CompareOperation , cnn:CountOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresValueStatus ,
        cnn:RequiresCoverageUniverse ;
    cnn:meaningStatus "unit_observed_only" ; cnn:alignmentDecision "유지" .


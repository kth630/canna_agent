    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf ;
    cnn:meaningStatus "per_share_inferred_from_magnitude" ; cnn:alignmentDecision "수정" .

etkr:NetAssetValueChangeAmount a cnn:MetricType ;

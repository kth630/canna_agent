    cnn:meaningStatus "entity_resolution_pending" ; cnn:alignmentDecision "미확정" ;
    rdfs:comment "같은 의미의 두 번째 출처이며 값이 다르면 충돌로 기록한다."@ko .

etkr:RefinitivManagementCompanyNameRaw a cnn:AttributeType ;
    rdfs:label "외부 출처 운용사명 원값"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation ;
    cnn:meaningStatus "entity_resolution_pending" ; cnn:alignmentDecision "미확정" .

etkr:RefinitivAssetTypeRaw a cnn:AttributeType ;
    rdfs:label "외부 출처 자산유형 원값"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation , cnn:GroupOperation ;
    cnn:meaningStatus "code_meaning_unverified" ; cnn:alignmentDecision "수정" .

etkr:RefinitivGeographicFocusRaw a cnn:AttributeType ;
    rdfs:label "외부 출처 투자지역 원값"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation , cnn:GroupOperation ;
    cnn:meaningStatus "code_meaning_unverified" ; cnn:alignmentDecision "수정" .

etkr:StrategyRaw a cnn:AttributeType ;
    rdfs:label "운용전략 원값"@ko ; cnn:approvedAlias "전략"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation , cnn:GroupOperation ;
    cnn:meaningStatus "code_meaning_unverified" ; cnn:alignmentDecision "수정" .

etkr:LeverageFactorRaw a cnn:AttributeType ;
    rdfs:label "배수 원값"@ko ; cnn:approvedAlias "레버리지"@ko , "인버스"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation ;
    cnn:meaningStatus "text_encoded_number" ; cnn:alignmentDecision "수정" ;
    rdfs:comment "국내 표에서는 text 로 제공되어 수치 연산 대상으로 승격하지 않는다."@ko .

etkr:PortfolioAverageCreditQuality a cnn:AttributeType ;
    rdfs:label "포트폴리오 평균 신용품질"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresCoverageUniverse ;
    cnn:meaningStatus "rating_scale_unverified" ; cnn:alignmentDecision "수정" .

etkr:DistributionCycleRaw a cnn:AttributeType ;
    rdfs:label "분배주기 원값"@ko ; cnn:approvedAlias "분배주기"@ko , "월배당"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation , cnn:GroupOperation ;
    cnn:meaningStatus "code_meaning_unverified" ; cnn:alignmentDecision "수정" .

etkr:DistributionPaymentMonthsRaw a cnn:AttributeType ;
    rdfs:label "분배 지급월 원값"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation ;
    cnn:meaningStatus "code_meaning_unverified" ; cnn:alignmentDecision "수정" .

etkr:DistributionTaxBasisRaw a cnn:AttributeType ;
    rdfs:label "분배 과세기준 원값"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;

    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresValueStatus ;
    cnn:meaningStatus "annualized_from_recent_trading_days" ; cnn:alignmentDecision "수정" .

etkr:Volatility1Y a cnn:MetricType ;
    rdfs:label "1년 변동성"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:PercentObserved ; cnn:observationPeriod cnn:Period1Y ;
    cnn:comparisonGroup "domestic_etp:volatility" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresValueStatus ;
    cnn:meaningStatus "annualized_from_recent_trading_days" ; cnn:alignmentDecision "수정" .

etkr:TrackingErrorRate a cnn:MetricType ;
    rdfs:label "추적오차율"@ko ; cnn:approvedAlias "추적오차"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:PercentObserved ; cnn:observationPeriod cnn:PeriodPointInTime ;
    cnn:comparisonGroup "domestic_etp:tracking_error" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresValueStatus ;
    cnn:meaningStatus "unit_observed_only" ; cnn:alignmentDecision "유지" .

etkr:PremiumDiscountRate a cnn:MetricType ;
    rdfs:label "괴리율"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:PercentObserved ; cnn:observationPeriod cnn:PeriodPointInTime ;
    cnn:comparisonGroup "domestic_etp:premium_discount" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresValueStatus ;
    cnn:meaningStatus "unit_observed_only" ; cnn:alignmentDecision "유지" .

etkr:TotalExpenseRate a cnn:MetricType ;
    rdfs:label "총보수율"@ko ; cnn:approvedAlias "총보수"@ko , "보수율"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:PercentObserved ; cnn:observationPeriod cnn:PeriodPointInTime ;
    cnn:comparisonGroup "domestic_etp:expense_rate" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ,
        cnn:CompareOperation ;
    cnn:evidenceRequirement cnn:RequiresValueStatus , cnn:RequiresCoverageUniverse ;
    cnn:meaningStatus "text_parsed_unit_unverified" ; cnn:alignmentDecision "수정" ;
    rdfs:comment "원문이 text 이고 관측 가능한 행이 적어 완전 모집단 주장에 쓰지 않는다."@ko .

##  5. 규모·가격·거래 지표

etkr:AssetsUnderManagement a cnn:MetricType ;
    rdfs:label "순자산 규모"@ko ; cnn:approvedAlias "AUM"@ko , "운용규모"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:CurrencyAmount ; cnn:currencyPolicy "from_subject_currency" ;
    cnn:observationPeriod cnn:PeriodPointInTime ; cnn:comparisonGroup "domestic_etp:aum" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ,
        cnn:CompareOperation , cnn:CountOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresUnitAndCurrency ,
        cnn:RequiresValueStatus ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "유지" .

etkr:NetAssetsTotal a cnn:MetricType ;
    rdfs:label "순자산총액"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:CurrencyAmount ; cnn:currencyPolicy "from_subject_currency" ;
    cnn:observationPeriod cnn:PeriodPointInTime ; cnn:comparisonGroup "domestic_etp:net_assets" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresUnitAndCurrency ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "수정" .

etkr:CirculatingNetAssets a cnn:MetricType ;
    rdfs:label "유통순자산총액"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:CurrencyAmount ; cnn:currencyPolicy "from_subject_currency" ;
    cnn:observationPeriod cnn:PeriodPointInTime ; cnn:comparisonGroup "domestic_etp:net_assets" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresValueStatus ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "수정" .

etkr:NetAssetValuePerShare a cnn:MetricType ;
    rdfs:label "주당 순자산가치"@ko ; cnn:approvedAlias "NAV"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:PriceUnit ; cnn:currencyPolicy "from_subject_currency" ;
    cnn:observationPeriod cnn:PeriodPointInTime ; cnn:comparisonGroup "domestic_etp:nav_per_share" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresUnitAndCurrency ;
    cnn:meaningStatus "per_share_inferred_from_magnitude" ; cnn:alignmentDecision "수정" ;
    rdfs:comment "순자산총액과 다른 지표이며 관측 크기가 기준가와 같은 자릿수다."@ko .

etkr:NetAssetValuePerSharePreviousDay a cnn:MetricType ;
    rdfs:label "전일 주당 순자산가치"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:PriceUnit ; cnn:currencyPolicy "from_subject_currency" ;
    cnn:observationPeriod cnn:PeriodPointInTime ;

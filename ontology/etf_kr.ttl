@prefix etkr: <https://canna.local/ontology/etf-kr#> .
@prefix cnn:  <https://canna.local/ontology/core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://canna.local/ontology/etf-kr>
    a owl:Ontology ;
    owl:imports <https://canna.local/ontology/core> ;
    rdfs:label "국내 상장지수상품 온톨로지"@ko ;
    rdfs:comment """공식 국내 상장지수상품 표는 ETF 와 ETN 을 함께 담는다. 기간별 지표는 서로 다른
기준일과 모집단을 가지며, 보유내역은 상품이 아니라 포트폴리오 관측에 붙는다."""@ko .

##  1. 개체와 식별자

etkr:DomesticExchangeTradedProduct a owl:Class ;
    rdfs:subClassOf cnn:ProjectProduct ;
    rdfs:label "국내 상장지수상품"@ko ;
    cnn:approvedAlias "국내 ETF"@ko , "국내 ETN"@ko , "상장지수상품"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ;
    cnn:semanticGrain cnn:ProductGrain ;
    cnn:alignmentDecision "유지" ;
    rdfs:comment "ETF 와 ETN 을 구분하는 근거는 상품군 종류 원값이며 임의 분류를 만들지 않는다."@ko .

etkr:DomesticExchangeTradedProductNumber a cnn:IdentifierScheme ;
    rdfs:label "국내 상장지수상품 번호"@ko ; cnn:approvedAlias "상품번호"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "수정" .

##  2. 상품 속성

etkr:PensionTradingRiskCategory a cnn:AttributeType ;
    rdfs:label "연금거래 위험구분"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation , cnn:GroupOperation ;
    cnn:meaningStatus "code_meaning_unverified" ; cnn:alignmentDecision "수정" .

etkr:SectorCodeRaw a cnn:AttributeType ;
    rdfs:label "섹터 코드 원값"@ko ; cnn:approvedAlias "ETF 섹터"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation ;
    cnn:meaningStatus "code_meaning_unverified" ; cnn:alignmentDecision "미확정" ;
    rdfs:comment "섹터 의미를 확정하지 않고 원문만 보존한다."@ko .

etkr:SpacFlagRaw a cnn:AttributeType ;
    rdfs:label "SPAC 여부 원값"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation ;
    cnn:meaningStatus "flag_polarity_unverified" ; cnn:alignmentDecision "수정" .

etkr:CoreProductFlagRaw a cnn:AttributeType ;
    rdfs:label "핵심 상품 여부 원값"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation ;
    cnn:meaningStatus "flag_polarity_unverified" ; cnn:alignmentDecision "수정" .

etkr:BaseIndexNameRaw a cnn:AttributeType ;
    rdfs:label "기초지수명 원값"@ko ; cnn:approvedAlias "기초지수"@ko , "추종지수"@ko ;
    cnn:appliesToFamily cnn:DomesticExchangeTradedFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation , cnn:GroupOperation ;
    cnn:meaningStatus "entity_resolution_pending" ; cnn:alignmentDecision "미확정" .

etkr:RefinitivBaseIndexNameRaw a cnn:AttributeType ;
    rdfs:label "외부 출처 기초지수명 원값"@ko ;

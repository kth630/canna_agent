##  8. SHACL

etkr:DomesticExchangeTradedProductShape a sh:NodeShape ;
    sh:targetClass etkr:DomesticExchangeTradedProduct ;
    sh:property [ sh:path cnn:familyOfSubject ; sh:hasValue "domestic_etp" ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:hasIdentifier ; sh:class cnn:Identifier ; sh:minCount 1 ] ;
    sh:property [ sh:path cnn:mapsToPortfolio ; sh:class cnn:Portfolio ;
                  sh:description "보유내역이 수집되지 않은 상품도 유효하다"@ko ] .

    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation ;
    cnn:meaningStatus "code_meaning_unverified" ; cnn:alignmentDecision "유지" .

fdpb:HouseSaleStatusRaw a cnn:AttributeType ;
    rdfs:label "당사 판매여부 원값"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ; cnn:semanticGrain cnn:ProductClassGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation , cnn:CountOperation ;
    cnn:meaningStatus "flag_polarity_unverified" ; cnn:alignmentDecision "수정" ;
    rdfs:comment "판매여부와 다른 축이므로 하나로 합치지 않는다."@ko .

fdpb:PublicOrPrivateOfferingRaw a cnn:AttributeType ;
    rdfs:label "공모·사모 구분 원값"@ko ; cnn:approvedAlias "공모"@ko , "사모"@ko ;

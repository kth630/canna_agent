##  7. SHACL

fdpb:PublicFundShareClassShape a sh:NodeShape ;
    sh:targetClass fdpb:PublicFundShareClass ;
    sh:property [ sh:path cnn:familyOfSubject ; sh:hasValue "public_fund" ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:hasIdentifier ; sh:class cnn:Identifier ; sh:minCount 1 ] ;
    sh:property [ sh:path cnn:memberOfClassGroup ; sh:class cnn:ProductClassGroup ;
                  sh:maxCount 1 ;
                  sh:description "대표 묶음이 없는 클래스도 유효하다"@ko ] .

fdpb:RepresentativeClassGroupShape a sh:NodeShape ;
    sh:targetClass fdpb:RepresentativeClassGroup ;
    sh:property [ sh:path cnn:identifierValue ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:mapsToPortfolio ; sh:class cnn:Portfolio ; sh:maxCount 1 ;
                  sh:description "묶음과 포트폴리오를 자동으로 동일시하지 않는다"@ko ] .

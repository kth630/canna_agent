##  3. 기간 수익률

fdpb:Return1M a cnn:MetricType ;
    rdfs:label "1개월 수익률"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ; cnn:semanticGrain cnn:ProductClassGrain ;
    cnn:unitKind cnn:PercentObserved ; cnn:observationPeriod cnn:Period1M ;
    cnn:comparisonGroup "public_fund:return" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ,
        cnn:CompareOperation , cnn:CountOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresValueStatus ,
        cnn:RequiresCoverageUniverse ;
    cnn:meaningStatus "unit_observed_only" ; cnn:alignmentDecision "유지" .

fdpb:Return3M a cnn:MetricType ;
    rdfs:label "3개월 수익률"@ko ;

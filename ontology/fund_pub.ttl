fdpb:InvestmentRiskGrade a cnn:AttributeType ;
    rdfs:label "펀드 투자위험등급"@ko ; cnn:approvedAlias "위험등급"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ; cnn:semanticGrain cnn:ProductClassGrain ;

@prefix fdpb: <https://canna.local/ontology/fund-pub#> .
@prefix cnn:  <https://canna.local/ontology/core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://canna.local/ontology/fund-pub>
    a owl:Ontology ;
    owl:imports <https://canna.local/ontology/core> ;
    rdfs:label "공모펀드 온톨로지"@ko ;
    rdfs:comment """공식 표의 행은 판매 클래스 단위다. 대표 클래스 묶음, 운용 포트폴리오, 보유내역은
서로 다른 단위이며 합치지 않는다. 승인된 단일 총보수 정의가 없으므로 보수는 구성요소로만 둔다."""@ko .

##  1. 개체와 식별자

fdpb:PubliclyOfferedFund a owl:Class ;
    rdfs:subClassOf cnn:ProjectProduct ;
    rdfs:label "공모펀드"@ko ;
    cnn:approvedAlias "펀드"@ko , "공모 집합투자기구"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ;
    cnn:semanticGrain cnn:ProductClassGrain ;
    cnn:alignmentDecision "유지" ;
    rdfs:comment "공식 표에는 공모와 사모가 함께 있으므로 구분 원값으로 판단한다."@ko .

fdpb:PublicFundShareClass a owl:Class ;
    rdfs:subClassOf cnn:ProductClass , fdpb:PubliclyOfferedFund ;
    rdfs:label "공모펀드 판매 클래스"@ko ;
    cnn:approvedAlias "펀드 클래스"@ko , "클래스"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ;
    cnn:semanticGrain cnn:ProductClassGrain ;
    cnn:alignmentDecision "유지" ;
    rdfs:comment "사용자에게 반환하는 기본 단위이며 같은 포트폴리오를 여러 클래스가 공유한다."@ko .

fdpb:RepresentativeClassGroup a owl:Class ;
    rdfs:subClassOf cnn:ProductClassGroup ;
    rdfs:label "대표 클래스 묶음"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ;
    cnn:semanticGrain cnn:ProductClassGrain ;
    cnn:alignmentDecision "수정" ;
    rdfs:comment "대표 예탁원 종목번호 기준 묶음이며 운용 포트폴리오와 자동으로 같지 않다."@ko .

fdpb:PublicFundShareClassNumber a cnn:IdentifierScheme ;
    rdfs:label "펀드 종목번호"@ko ; cnn:approvedAlias "종목번호"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "유지" .

fdpb:StandardItemNumber a cnn:IdentifierScheme ;
    rdfs:label "표준종목번호"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "수정" ;
    rdfs:comment "외부 보유내역 수집이 클래스 조회 key 로 사용한 값이다."@ko .

fdpb:KsdItemNumber a cnn:IdentifierScheme ;
    rdfs:label "예탁원 종목번호"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "수정" .

fdpb:FssItemNumber a cnn:IdentifierScheme ;
    rdfs:label "금융감독원 종목번호"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ;
    cnn:meaningStatus "placeholder_values_present" ; cnn:alignmentDecision "수정" ;
    rdfs:comment "0 으로만 이루어진 값은 식별자가 아니라 자리채움이다."@ko .

fdpb:ManagementCompanyItemNumber a cnn:IdentifierScheme ;
    rdfs:label "운용사 종목번호"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "수정" .

fdpb:RepresentativeClassGroupKey a cnn:IdentifierScheme ;
    rdfs:label "대표 예탁원 종목번호"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ;
    cnn:meaningStatus "placeholder_values_present" ; cnn:alignmentDecision "수정" ;
    rdfs:comment "외부 보유내역 수집의 포트폴리오 식별자와 값이 일치하는 것으로 관측됐다."@ko .

##  2. 클래스 속성

fdpb:ShareClassDisplayName a cnn:AttributeType ;
    rdfs:label "클래스 표기"@ko ; cnn:approvedAlias "클래스명"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ; cnn:semanticGrain cnn:ProductClassGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation , cnn:GroupOperation ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "유지" .

fdpb:ShareClassFeeTypeRaw a cnn:AttributeType ;
    rdfs:label "클래스 수수료 부과 유형"@ko ; cnn:approvedAlias "선취"@ko , "후취"@ko ;

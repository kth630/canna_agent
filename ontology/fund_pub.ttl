    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation , cnn:GroupOperation ;
    cnn:meaningStatus "code_meaning_unverified" ; cnn:alignmentDecision "유지" .

fdpb:ShareClassSalesChannelRaw a cnn:AttributeType ;
    rdfs:label "클래스 판매채널"@ko ; cnn:approvedAlias "온라인 클래스"@ko , "판매채널"@ko ;
    cnn:appliesToFamily cnn:PublicFundFamily ; cnn:semanticGrain cnn:ProductClassGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation , cnn:GroupOperation ;

    cnn:evidenceRequirement cnn:RequiresValueStatus ;
    cnn:meaningStatus "unit_unverified" ; cnn:alignmentDecision "유지" .

bdkr:RemainingDays a cnn:MetricType ;
    rdfs:label "잔존일수"@ko ; cnn:approvedAlias "잔존기간"@ko ;
    cnn:appliesToFamily cnn:DomesticBondFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:DaysUnit ; cnn:observationPeriod cnn:PeriodPointInTime ;
    cnn:comparisonGroup "domestic_bond:remaining_days" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ,
        cnn:CompareOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresValueStatus ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "유지" .

bdkr:IssueBalanceAmount a cnn:MetricType ;
    rdfs:label "발행잔액"@ko ;
    cnn:appliesToFamily cnn:DomesticBondFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:CurrencyAmount ; cnn:currencyPolicy "from_subject_currency" ;
    cnn:observationPeriod cnn:PeriodPointInTime ; cnn:comparisonGroup "domestic_bond:issue_amount" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ;
    cnn:evidenceRequirement cnn:RequiresUnitAndCurrency , cnn:RequiresValueStatus ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "유지" .

bdkr:TotalIssueAmount a cnn:MetricType ;
    rdfs:label "총발행금액"@ko ;
    cnn:appliesToFamily cnn:DomesticBondFamily ; cnn:semanticGrain cnn:ProductGrain ;
    cnn:unitKind cnn:CurrencyAmount ; cnn:currencyPolicy "from_subject_currency" ;
    cnn:observationPeriod cnn:PeriodPointInTime ; cnn:comparisonGroup "domestic_bond:issue_amount" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ;
    cnn:evidenceRequirement cnn:RequiresUnitAndCurrency , cnn:RequiresValueStatus ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "유지" .

##  6. SHACL

bdkr:KoreanBondShape a sh:NodeShape ;
    sh:targetClass bdkr:KoreanBond ;
    sh:property [ sh:path cnn:familyOfSubject ; sh:hasValue "domestic_bond" ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:hasIdentifier ; sh:class cnn:Identifier ; sh:minCount 1 ] .

bdkr:BondLotContextShape a sh:NodeShape ;
    sh:targetClass bdkr:BondLotContext ;
    sh:property [ sh:path cnn:sourceRowId ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ;
                  sh:description "판매 LOT 맥락은 원본 행 하나를 가리킨다"@ko ] .

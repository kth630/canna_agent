    cnn:observationPeriod cnn:PeriodPointInTime ; cnn:comparisonGroup "domestic_bond:price_next_day" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation ;
    cnn:evidenceRequirement cnn:RequiresEffectiveAsOf , cnn:RequiresUnitAndCurrency ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "유지" .

bdkr:DirtyPrice a cnn:MetricType ;
    rdfs:label "이자부단가"@ko ; cnn:approvedAlias "dirty price"@en ;

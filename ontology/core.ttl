    cnn:semanticGrain cnn:HoldingObservationGrain ; cnn:unitKind cnn:NoUnit ;
    cnn:allowedOperation cnn:FilterOperation ;
    cnn:meaningStatus "entity_resolution_pending" ; cnn:alignmentDecision "추가" .
cnn:MappingStatusType a cnn:AttributeType ;
    rdfs:label "매핑 상태"@ko ; cnn:semanticGrain cnn:ProductGrain ; cnn:unitKind cnn:NoUnit ;
    cnn:allowedOperation cnn:FilterOperation , cnn:CountOperation ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "추가" .
cnn:MappingBasisType a cnn:AttributeType ;
    rdfs:label "매핑 근거"@ko ; cnn:semanticGrain cnn:ProductGrain ; cnn:unitKind cnn:NoUnit ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "추가" .
cnn:SourceReferenceType a cnn:AttributeType ;
    rdfs:label "출처 표기"@ko ; cnn:semanticGrain cnn:HoldingObservationGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "유지" .
cnn:SourceRecordIdentifierType a cnn:AttributeType ;
    rdfs:label "원본 record 식별자"@ko ; cnn:semanticGrain cnn:HoldingObservationGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "유지" .
cnn:SnapshotScopeType a cnn:AttributeType ;
    rdfs:label "스냅샷 범위"@ko ; cnn:semanticGrain cnn:HoldingObservationGrain ;
    cnn:unitKind cnn:NoUnit ; cnn:allowedOperation cnn:FilterOperation ;
    cnn:evidenceRequirement cnn:RequiresCoverageUniverse ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "추가" .
cnn:FailureStageType a cnn:AttributeType ;
    rdfs:label "수집 실패 단계"@ko ; cnn:unitKind cnn:NoUnit ;
    cnn:semanticGrain cnn:CollectionFailureGrain ;
    cnn:allowedOperation cnn:FilterOperation , cnn:GroupOperation , cnn:CountOperation ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "추가" .
cnn:FailureCodeType a cnn:AttributeType ;
    rdfs:label "수집 실패 코드"@ko ; cnn:unitKind cnn:NoUnit ;
    cnn:semanticGrain cnn:CollectionFailureGrain ;
    cnn:allowedOperation cnn:FilterOperation , cnn:GroupOperation , cnn:CountOperation ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "추가" .
cnn:HoldingWeightType a cnn:MetricType ;
    rdfs:label "보유 비중"@ko ; cnn:approvedAlias "비중"@ko ;
    cnn:semanticGrain cnn:HoldingObservationGrain ; cnn:unitKind cnn:PercentObserved ;
    cnn:observationPeriod cnn:PeriodPointInTime ;
    cnn:comparisonGroup "holding_weight" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation ;
    cnn:evidenceRequirement cnn:RequiresCoverageUniverse , cnn:RequiresRelationKind ;
    cnn:meaningStatus "source_coverage_limited" ; cnn:alignmentDecision "수정" ;
    rdfs:comment "원천에 따라 비중이 비어 있거나 스왑 명목가 기준이라 상품군 간 비교에 쓰지 않는다."@ko .
cnn:HoldingQuantityType a cnn:MetricType ;
    rdfs:label "보유 수량"@ko ; cnn:approvedAlias "수량"@ko ;
    cnn:semanticGrain cnn:HoldingObservationGrain ; cnn:unitKind cnn:CountUnit ;
    cnn:observationPeriod cnn:PeriodPointInTime ; cnn:comparisonGroup "holding_quantity" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation ;
    cnn:evidenceRequirement cnn:RequiresUnitAndCurrency ;
    cnn:meaningStatus "unit_unverified" ; cnn:alignmentDecision "수정" .
cnn:HoldingValueAmountType a cnn:MetricType ;
    rdfs:label "보유 평가금액"@ko ; cnn:approvedAlias "평가금액"@ko ;
    cnn:semanticGrain cnn:HoldingObservationGrain ; cnn:unitKind cnn:CurrencyAmount ;
    cnn:currencyPolicy "from_observation_currency" ;
    cnn:observationPeriod cnn:PeriodPointInTime ; cnn:comparisonGroup "holding_value" ;
    cnn:allowedOperation cnn:FilterOperation , cnn:OrderOperation , cnn:AggregateOperation ;
    cnn:evidenceRequirement cnn:RequiresUnitAndCurrency , cnn:RequiresEffectiveAsOf ;
    cnn:meaningStatus "currency_mixed" ; cnn:alignmentDecision "수정" .

##  8. SHACL - ABox 투영이 지켜야 하는 모양

cnn:ProductShape a sh:NodeShape ;
    sh:targetClass cnn:ProjectProduct ;
    sh:property [ sh:path cnn:subjectKey ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:familyOfSubject ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:hasIdentifier ; sh:class cnn:Identifier ; sh:minCount 1 ] .

cnn:ProductClassShape a sh:NodeShape ;
    sh:targetClass cnn:ProductClass ;
    sh:property [ sh:path cnn:memberOfClassGroup ; sh:class cnn:ProductClassGroup ;
                  sh:maxCount 1 ;
                  sh:description "대표 그룹은 선택이며 포트폴리오로 대체하지 않는다"@ko ] .

cnn:IdentifierShape a sh:NodeShape ;
    sh:targetClass cnn:Identifier ;
    sh:property [ sh:path cnn:identifierValue ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:identifierScheme ; sh:class cnn:IdentifierScheme ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:resolutionStatus ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] .

cnn:PortfolioShape a sh:NodeShape ;
    sh:targetClass cnn:Portfolio ;
    sh:property [ sh:path cnn:subjectKey ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:identifierValue ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] .

cnn:SecurityShape a sh:NodeShape ;
    sh:targetClass cnn:Security ;
    sh:property [ sh:path cnn:identifierValue ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:identifierScheme ; sh:class cnn:IdentifierScheme ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:resolutionStatus ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "checksum_verified" "format_matched" ) ;
                  sh:description "해석되지 않은 식별자는 Security 로 승격하지 않는다"@ko ] .

cnn:MetricObservationShape a sh:NodeShape ;
    sh:targetClass cnn:MetricObservation ;
    sh:property [ sh:path cnn:observedSubject ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:metricType ; sh:class cnn:MetricType ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:valueStatus ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:asOfStatus ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:numericValue ; sh:datatype xsd:double ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:fromSource ; sh:class cnn:DataSource ; sh:minCount 1 ] ;
    sh:property [ sh:path cnn:sourceRowId ; sh:datatype xsd:string ; sh:minCount 1 ] .

cnn:AttributeObservationShape a sh:NodeShape ;
    sh:targetClass cnn:AttributeObservation ;
    sh:property [ sh:path cnn:observedSubject ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:attributeType ; sh:class cnn:AttributeType ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:valueStatus ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path cnn:fromSource ; sh:class cnn:DataSource ; sh:minCount 1 ] ;
    sh:or ( [ sh:property [ sh:path cnn:codeValue ; sh:minCount 1 ] ]
            [ sh:property [ sh:path cnn:labelValue ; sh:minCount 1 ] ]
            [ sh:property [ sh:path cnn:dateValue ; sh:minCount 1 ] ] ) .

cnn:HoldingObservationShape a sh:NodeShape ;
    sh:targetClass cnn:HoldingObservation ;
    sh:property [ sh:path cnn:portfolioOfObservation ; sh:class cnn:Portfolio ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:relationKind ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:asOfStatus ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:heldSecurity ; sh:class cnn:Security ; sh:maxCount 1 ;
                  sh:description "식별자가 없는 원시 관측도 유효하다"@ko ] ;
    sh:property [ sh:path cnn:sourceRecordId ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:or ( [ sh:property [ sh:path cnn:heldSecurityIdentifierRaw ; sh:minCount 1 ] ]
            [ sh:property [ sh:path cnn:heldSecurityNameRaw ; sh:minCount 1 ] ] ) .

cnn:ProductPortfolioMappingShape a sh:NodeShape ;
    sh:targetClass cnn:ProductPortfolioMapping ;
    sh:property [ sh:path cnn:mappingStatusValue ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:mappedSubject ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:mappedPortfolio ; sh:class cnn:Portfolio ; sh:maxCount 1 ;
                  sh:description "미해결 매핑은 포트폴리오를 갖지 않는다"@ko ] .

cnn:CoverageObservationShape a sh:NodeShape ;
    sh:targetClass cnn:CoverageObservation ;
    sh:property [ sh:path cnn:coverageOfFamily ; sh:class cnn:ProductFamily ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:snapshotScope ; sh:datatype xsd:string ; sh:maxCount 1 ] .

cnn:CollectionFailureShape a sh:NodeShape ;
    sh:targetClass cnn:CollectionFailure ;
    sh:property [ sh:path cnn:codeValue ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path cnn:fromSource ; sh:class cnn:DataSource ; sh:minCount 1 ] .

cnn:DataSourceShape a sh:NodeShape ;
    sh:targetClass cnn:DataSource ;
    sh:property [ sh:path cnn:sourceDigest ; sh:datatype xsd:string ;
                  sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cnn:sourcePrecedence ; sh:datatype xsd:integer ;
                  sh:minCount 1 ; sh:maxCount 1 ] .

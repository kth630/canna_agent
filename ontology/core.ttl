cnn:RicIdentifier a cnn:IdentifierScheme ;
    rdfs:label "RIC"@ko ; cnn:approvedAlias "Refinitiv 코드"@ko ;
    cnn:meaningStatus "confirmed" ; cnn:alignmentDecision "수정" .
